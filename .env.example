# Development placeholders only. Copy to .env when you deviate from compose.yaml;
# .env is git-ignored and excluded from the Docker build context.
# Local host ports (compose.yaml): PostgreSQL 55433, Redis 56380.
DATABASE_URL=postgresql://hookrelay:hookrelay@127.0.0.1:55433/hookrelay
REDIS_URL=redis://127.0.0.1:56380/0
LOG_LEVEL=INFO

# Production is configured through the process environment (Fly secrets),
# never through a file: SECRET_KEY, DATABASE_URL, REDIS_URL, ALLOWED_HOSTS,
# FORWARDED_ALLOW_IPS (uvicorn trust boundary for X-Forwarded-* headers).
